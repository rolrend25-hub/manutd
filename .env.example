# 복사해서 .env 로 저장 후 값 입력 (.env 는 절대 공개 저장소에 올리지 말 것)

# 경기 일정/결과/순위 - https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# 선수 통계/라인업/이벤트/이적 - https://dashboard.api-football.com/register
API_FOOTBALL_KEY=

# 경기 분석 생성 (현재 미사용 - 무료 템플릿 요약으로 진행. 나중에 전환 시 입력)
# ANTHROPIC_API_KEY=
# ANALYSIS_MODEL=claude-sonnet-5-5

# 카카오톡 "나에게 보내기" - https://developers.kakao.com (내 애플리케이션 > REST API 키)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REFRESH_TOKEN=

# 스마트폰 알람용 구글 캘린더 (선택) - 서비스 계정 JSON 경로 + 공유한 캘린더 ID
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
