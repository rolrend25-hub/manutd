# 복사해서 .env 로 저장 후 값 입력 (.env 는 절대 공개 저장소에 올리지 말 것)

# 경기 일정/결과/순위 - https://www.football-data.org/client/register
FOOTBALL_DATA_TOKEN=

# 선수 통계/라인업/이벤트/이적 - https://dashboard.api-football.com/register
API_FOOTBALL_KEY=

# 뉴스 제목·요약 한글 번역 (기계번역, 월 50만 자 무료) - https://www.deepl.com/pro-api (API Free, ':fx' 로 끝나는 키)
DEEPL_API_KEY=

# 경기 분석은 Claude API 미사용 (2026-11-12 결정) - 규칙 기반 템플릿 요약

# 카카오톡 "나에게 보내기" - https://developers.kakao.com (내 애플리케이션 > REST API 키)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 리프레시 토큰은 python scripts/kakao_login.py 가 자동으로 채움
KAKAO_REFRESH_TOKEN=
# 카카오 로그인 > Redirect URI 에 등록한 값 (비우면 http://localhost:8765/callback)
KAKAO_REDIRECT_URI=

# 스마트폰 알람용 구글 캘린더 (선택) - 서비스 계정 JSON 경로 + 공유한 캘린더 ID
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
